# Скопировать в /mnt/different-project/mnemo-env/.env и заполнить.
# Файл лежит ВНЕ git-репозитория, чтобы токен никогда не попал в GitHub.

# Токен нового бота из @BotFather
BOT_TOKEN=123456789:AA...

# Chat id администратора — узнаётся командой /id у своего же бота
ADMIN_CHAT_ID=

# Ссылка на бота для кнопки «Запросить пароль»
APP_URL=https://spainlearn123.duckdns.org

# Порт локального API (8080 занят Hyper)
PORT=8790

# Куда складывать пользователей и прогресс — вне репозитория, git pull их не тронет
DATA_DIR=/mnt/different-project/mnemo-data
